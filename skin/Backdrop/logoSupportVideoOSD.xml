    <!-- Video Codecs -->
    <control>
      <description>Video Codecs</description>
      <type>image</type>
      <id>0</id>
      <posX>1551</posX>
      <posY>900</posY>
      <width>72</width>
      <height>40</height>
      <keepaspectratio>yes</keepaspectratio>
      <centered>yes</centered>
      <colordiffuse>95FFFFFF</colordiffuse>
      <texture>Logos_W\VideoCodecs\#Play.Current.VideoCodec.Texture.png</texture>
      <visible>Control.IsVisible(1700)</visible>
      <!--<animation effect="fade" time="400" reversible="true">VisibleChange</animation>	-->
      <animation effect="fade" start="0" end="100" time="100" delay="250" reversible="false">visible</animation>
      <animation effect="fade" start="100" end="0" time="30" reversible="false">hidden</animation>
      <animation effect="fade" start="0" end="100" time="350">WindowOpen</animation>
      <animation effect="fade" start="100" end="0" time="350">WindowClose</animation>
    </control>
