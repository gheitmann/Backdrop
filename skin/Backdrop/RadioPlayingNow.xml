<?xml version='1.0' encoding='utf-8'?>
<window>
  <id>764</id>
  <defaultcontrol>0</defaultcontrol>
  <allowoverlay>no</allowoverlay>
  <disabletopbar>no</disabletopbar>
  <controls>
    <control>
      <description>Radio studio background</description>
      <type>image</type>
      <id>0</id>
      <texture>#(iif(string.equals(#DayNight.Period,'morning'),'Modern/Morning/studio.png',iif(string.equals(#DayNight.Period,'noon'),'Modern/Noon/studio.png',iif(string.equals(#DayNight.Period,'day'),'Modern/Day/studio.png','Modern/studio.jpg'))))</texture>
      <posX>0</posX>
      <posY>0</posY>
      <width>1920</width>
      <height>1080</height>
    </control>
    <control>
      <description>Readable radio metadata panel</description>
      <type>image</type>
      <id>0</id>
      <texture>black_transp_overlay2.png</texture>
      <posX>1030</posX>
      <posY>155</posY>
      <width>830</width>
      <height>790</height>
    </control>
    <import>common.time.xml</import>
    <control>
      <description>Radio heading</description>
      <type>label</type>
      <id>0</id>
      <label>665</label>
      <font>font32</font>
      <posX>30</posX>
      <posY>45</posY>
      <width>1400</width>
      <height>75</height>
      <textcolor>ffffffff</textcolor>
    </control>
    <control>
      <description>Station logo fallback</description>
      <type>image</type>
      <id>0</id>
      <texture>DefaultMyradioBig.png</texture>
      <posX>170</posX>
      <posY>210</posY>
      <width>700</width>
      <height>570</height>
      <keepaspectratio>yes</keepaspectratio>
      <visible>!Control.HasThumb(112)</visible>
    </control>
    <control>
      <description>Station logo</description>
      <type>image</type>
      <id>112</id>
      <texture>#Radio.Listen.Thumb</texture>
      <posX>170</posX>
      <posY>210</posY>
      <width>700</width>
      <height>570</height>
      <keepaspectratio>yes</keepaspectratio>
    </control>
    <control>
      <description>Station</description>
      <type>fadelabel</type>
      <id>0</id>
      <label>#(iif(eq(#Radio.Listen.Channel,''),#Play.Current.Album,#Radio.Listen.Channel))</label>
      <posX>1080</posX>
      <posY>180</posY>
      <width>720</width>
      <height>60</height>
      <font>font22</font>
      <textcolor>ffffffff</textcolor>
      <scrollStartDelaySec>5</scrollStartDelaySec>
    </control>
    <control>
      <description>Now playing</description>
      <type>fadelabel</type>
      <id>0</id>
      <label>4540</label>
      <posX>1080</posX>
      <posY>260</posY>
      <width>720</width>
      <height>60</height>
      <font>font12</font>
      <textcolor>ff7FB1E5</textcolor>
      <scrollStartDelaySec>5</scrollStartDelaySec>
    </control>
    <control>
      <description>Programme</description>
      <type>fadelabel</type>
      <id>0</id>
      <label>#(iif(eq(#Radio.Listen.Title,''),#Play.Current.Title,#Radio.Listen.Title))</label>
      <posX>1080</posX>
      <posY>305</posY>
      <width>720</width>
      <height>60</height>
      <font>font16</font>
      <textcolor>ffffffff</textcolor>
      <scrollStartDelaySec>5</scrollStartDelaySec>
    </control>
    <control>
      <description>Metadata separator</description>
      <type>image</type>
      <id>0</id>
      <texture>default.line.separator.png</texture>
      <posX>1080</posX>
      <posY>385</posY>
      <width>720</width>
      <height>9</height>
    </control>
    <control>
      <description>Programme description</description>
      <type>textboxscrollup</type>
      <id>0</id>
      <label>#Radio.Listen.Description</label>
      <posX>1080</posX>
      <posY>415</posY>
      <width>720</width>
      <height>230</height>
      <font>font12</font>
      <textcolor>ffffffff</textcolor>
    </control>
    <control>
      <description>Programme progress</description>
      <type>progress</type>
      <id>1</id>
      <posX>1080</posX>
      <posY>680</posY>
      <width>720</width>
      <height>15</height>
      <label>#Radio.Listen.Percentage</label>
      <texturebg>progressback.png</texturebg>
      <lefttexture>-</lefttexture>
      <midtexture>progressbar_mid.png</midtexture>
      <righttexture>-</righttexture>
      <onlymidtexture>yes</onlymidtexture>
      <midwidth>720</midwidth>
      <midheight>15</midheight>
      <midoffsetX>0</midoffsetX>
      <midoffsetY>0</midoffsetY>
      <visible>!string.equals(#Radio.Listen.Percentage, )</visible>
    </control>
    <control>
      <description>Programme time</description>
      <type>label</type>
      <id>0</id>
      <label>#Radio.Listen.Played / #Radio.Listen.Remaining</label>
      <posX>1080</posX>
      <posY>710</posY>
      <width>720</width>
      <height>42</height>
      <font>font12</font>
      <textcolor>ffffffff</textcolor>
      <visible>!string.equals(#Radio.Listen.Percentage, )</visible>
    </control>
    <control>
      <description>Playing next heading</description>
      <type>label</type>
      <id>0</id>
      <label>4541</label>
      <posX>1080</posX>
      <posY>780</posY>
      <width>720</width>
      <height>42</height>
      <font>font12</font>
      <textcolor>ff7FB1E5</textcolor>
    </control>
    <control>
      <description>Next programme</description>
      <type>fadelabel</type>
      <id>0</id>
      <label>#(iif(eq(#Play.Next.Title,''),L(736),#Play.Next.Title))</label>
      <posX>1080</posX>
      <posY>825</posY>
      <width>720</width>
      <height>50</height>
      <font>font14</font>
      <textcolor>ffffffff</textcolor>
    </control>
  </controls>
</window>
