      <height>1080</height>
      <texture>overlay.default.wide.png</texture>
      <visible>[facadeview.list|facadeview.album|facadeview.playlist]+!Control.IsVisible(50)</visible>
    </control>
    <control>
      <type>listcontrol</type>
      <description>videolist</description>
      <id>4</id>
      <posY>510</posY>
      <posX>1299</posX>
      <height>300</height>
      <width>615</width>
      <spinPosY>1200</spinPosY>
      <spinPosX>2100</spinPosX>
      <textXOff>24</textXOff>
      <textYOff>0</textYOff>
      <textureFocus>playlist_sub_focus1.png</textureFocus>
      <textureNoFocus>playlist_sub_nofocus1.png</textureNoFocus>
      <textureUp>-</textureUp>
      <textureDown>-</textureDown>
      <spinCanFocus>no</spinCanFocus>
      <font>font16</font>
      <textureHeight>52</textureHeight>
      <textalign>right</textalign>
      <onleft>4</onleft>
      <onright>4</onright>
      <shadowAngle>45</shadowAngle>
      <shadowDistance>1</shadowDistance>
      <shadowColor>FF000000</shadowColor>
      <unfocusedAlpha>180</unfocusedAlpha>
      <dimColor>ffffffff</dimColor>
      <textcolor>ffffffff</textcolor>
      <selectedColor>ff335266</selectedColor>
      <shadedColor>ffffffff</shadedColor>
      <playedColor>ffffffff</playedColor>
      <textcolor2>ffffffff</textcolor2>
      <textcolor3>ffffffff</textcolor3>
      <colordiffuse>ffffffff</colordiffuse>
      <remoteColor>ffcccccc</remoteColor>
      <spaceBetweenItems>-1</spaceBetweenItems>
      <animation effect="slide" start="750,0" time="800" acceleration="-0.9" reversible="false">focus</animation>
      <animation effect="slide" end="750,0" time="200" acceleration="0.5" reversible="false">unfocus</animation>
      <visible>!Control.IsVisible(50)</visible>
    </control>
    <control>
