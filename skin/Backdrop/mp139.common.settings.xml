<?xml version='1.0' encoding='utf-8'?>
<window>
  <controls>
    <control>
      <description>BG</description>
      <type>image</type>
      <id>1</id>
      <texture>#(iif(string.equals(#DayNight.Period,'morning'),'Modern/Morning/settings-console.png',iif(string.equals(#DayNight.Period,'noon'),'Modern/Noon/settings-console.png',iif(string.equals(#DayNight.Period,'day'),'Modern/Day/settings-console.png','Modern/settings-console.png'))))</texture>
      <width>1920</width>
      <height>1080</height>
      <colordiffuse>ff707070</colordiffuse>
    </control>
    <control>
      <description>background top overlay</description>
      <type>image</type>
      <id>1</id>
      <posX>0</posX>
      <posY>0</posY>
      <width>1920</width>
      <height>180</height>
      <texture>overlay.default.png</texture>
      <colordiffuse>99ffffff</colordiffuse>
    </control>
    <control>
      <description>General Overlay</description>
      <id>0</id>
      <type>image</type>
      <posX>0</posX>
      <posY>45</posY>
      <width>1920</width>
      <height>1080</height>
      <texture>-</texture>
      <visible>!window.isvisible(4)</visible>
    </control>
    <control>
      <description>background</description>
      <type>image</type>
      <id>0</id>
      <posX>70</posX>
      <posY>239</posY>
      <width>448</width>
      <height>690</height>
      <texture>black_transp_overlay2.png</texture>
      <visible>!window.isvisible(4)+!skin.hassetting(#skin.basichome.editor)</visible>
    </control>
    <control>
      <description>background</description>
      <type>image</type>
      <id>0</id>
      <posX>620</posX>
      <posY>239</posY>
      <width>1280</width>
      <height>689</height>
      <texture>black_transp_overlay2.png</texture>
      <visible>!window.isvisible(4)+!skin.hassetting(#skin.basichome.editor)</visible>
    </control>
    <control>
      <id>1</id>
      <type>label</type>
      <posX>70</posX>
      <posY>284</posY>
      <width>448</width>
      <label>924</label>
      <textcolor>lightgray</textcolor>
      <align>center</align>
      <font>font12</font>
      <visible>!window.isvisible(4)+!skin.hassetting(#skin.basichome.editor)</visible>
      <disabledcolor>90ffffff</disabledcolor>
      <shadowAngle>0</shadowAngle>
      <shadowDistance>0</shadowDistance>
      <shadowColor />
    </control>
    <control>
      <type>label</type>
      <id>1</id>
      <posX>45</posX>
      <posY>54</posY>
      <label>#(iif(and(neq(L(102012), #currentmodule), neq(L(102002), #currentmodule), neq(L(100100), #currentmodule), neq(L(102015), #currentmodule)), #currentmodule, ' '))</label>
      <width>1802</width>
      <align>left</align>
      <font>font12</font>
      <shadowAngle>10</shadowAngle>
      <shadowDistance>3</shadowDistance>
      <shadowColor>ff000000</shadowColor>
      <textcolor>lightgray</textcolor>
      <colordiffuse>ffffffff</colordiffuse>
      <disabledcolor>90ffffff</disabledcolor>
    </control>
    <control>
      <type>label</type>
      <id>1</id>
      <posX>700</posX>
      <posY>260</posY>
      <width>1000</width>
      <label>#currentmodule</label>
      <textcolor>lightgray</textcolor>
      <font>font12</font>
      <visible>!window.isvisible(4)+!skin.hassetting(#skin.basichome.editor)</visible>
      <disabledcolor>90ffffff</disabledcolor>
      <shadowAngle>0</shadowAngle>
      <shadowDistance>0</shadowDistance>
      <shadowColor />
    </control>
  </controls>
</window>