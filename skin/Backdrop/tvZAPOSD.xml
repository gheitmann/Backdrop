<?xml version="1.0" encoding="UTF-8"?>
<window>
  <id>3007</id>
  <defaultcontrol>213</defaultcontrol>
  <allowoverlay>no</allowoverlay>
  <disabletopbar>yes</disabletopbar>
  <controls>
    <control>
      <description>background</description>
      <type>image</type>
      <id>300</id>
      <posX>0</posX>
      <posY>766</posY>
      <width>1920</width>
      <height>314</height>
      <texture>osdbackground.png</texture>
      <!--<animation effect="fade" time="300" reversible="true">VisibleChange</animation>	  -->
    </control>
    <control>
      <description>TV Logo</description>
      <type>image</type>
      <id>10</id>
      <posX>150</posX>
      <posY>786</posY>
      <width>135</width>
      <height>135</height>
      <texture flipY="true" diffuse="diffusemirrorwide.png">#TV.View.thumb</texture>
      <keepaspectratio>yes</keepaspectratio>
      <centered>yes</centered>
    </control>
