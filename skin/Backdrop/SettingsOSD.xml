    </control>
    <control>
      <description>OSD Timeout label</description>
      <type>label</type>
      <id>100</id>
      <posX>819</posX>
      <posY>300</posY>
      <label>472</label>
      <font>font13</font>
      <textcolor>FFFFFFFF</textcolor>
      <animation effect="fade" start="0" end="100" time="350">WindowOpen</animation>
      <animation effect="fade" start="100" end="0" time="350">WindowClose</animation>
    </control>
    <control>
      <description>OSD Timeout</description>
      <type>spincontrol</type>
      <id>2</id>
      <posX>1479</posX>
      <posY>308</posY>
      <textcolor>FFFFFFFF</textcolor>
      <onup>17</onup>
      <ondown>2</ondown>
      <onleft>20</onleft>
      <onright>20</onright>
      <buddycontrolid>100</buddycontrolid>
      <animation effect="fade" start="0" end="100" time="350">WindowOpen</animation>
      <animation effect="fade" start="100" end="0" time="350">WindowClose</animation>
    </control>
  </controls>
