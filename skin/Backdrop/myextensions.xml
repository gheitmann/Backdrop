<?xml version='1.0' encoding='utf-8'?>
<window>
  <id>800</id>
  <defaultcontrol>2</defaultcontrol>
  <allowoverlay>no</allowoverlay>
  <disabletopbar>no</disabletopbar>
  <define>#header.label:14001</define>
  <controls>
    <control>
      <description>Default Background</description>
      <type>image</type>
      <id>0</id>
      <posX>0</posX>
      <posY>0</posY>
      <width>1920</width>
      <height>1080</height>
      <texture>#(iif(string.equals(#DayNight.Period,'morning'),'Modern/Morning/plugins-browser.png',iif(string.equals(#DayNight.Period,'noon'),'Modern/Noon/plugins-browser.png',iif(string.equals(#DayNight.Period,'day'),'Modern/Day/plugins-browser.png','Modern/plugins-browser.png'))))</texture>
      <animation effect="fade" time="400" delay="0">WindowOpen</animation>
    </control>
    <control>
      <description>Overlay</description>
      <type>image</type>
      <id>0</id>
      <posX>0</posX>
      <posY>0</posY>
      <width>1920</width>
      <height>1080</height>
      <texture>mainoverlay.png</texture>
    </control>
    <control>
      <type>actiongroup</type>
      <description>action menu</description>
      <defaultcontrol>2</defaultcontrol>
      <onexit>50</onexit>
      <dimColor>00ffffff</dimColor>
      <control>
        <type>image</type>
        <posX>1503</posX>
        <posY>0</posY>
        <width>417</width>
        <height>1080</height>
        <texture>hiddenmenu_right.png</texture>
        <visible>!Control.HasFocus(50)</visible>
        <animation effect="slide" time="100" start="300,0">visible</animation>
        <animation effect="slide" time="0" end="300,0">hidden</animation>
      </control>
      <control>
        <id>0</id>
        <label>VIEW OPTIONS</label>
        <type>label</type>
        <font>font12BC</font>
        <posX>1560</posX>
        <posY>338</posY>
        <visible>!Control.HasFocus(50)</visible>
        <animation effect="slide" time="100" start="300,0">visible</animation>
        <animation effect="slide" time="0" end="300,0">hidden</animation>
      </control>
      <control>
        <type>group</type>
        <description>group element</description>
        <visible>!Control.HasFocus(50)</visible>
        <animation effect="slide" time="100" start="300,0">visible</animation>
        <animation effect="slide" time="0" end="300,0">hidden</animation>
        <posX>1560</posX>
        <posY>375</posY>
        <width>330</width>
        <height>1080</height>
        <layout>StackLayout</layout>
        <control>
          <description>View-As</description>
          <type>button</type>
          <id>2</id>
          <label>100</label>
          <onright>50</onright>
          <onup>17</onup>
        </control>
        <control>
          <description>Sort</description>
          <type>sortbutton</type>
          <id>3</id>
          <onright>50</onright>
        </control>
        <control>
          <description>Views</description>
          <type>button</type>
          <id>6</id>
          <label>14002</label>
          <onright>50</onright>
        </control>
      </control>
    </control>
    <import>common.window.xml</import>
    <import>common.time.xml</import>
    <import>common.facade.video.xml</import>
  </controls>
  <!--<animation effect="fade" start="100" end="0" time="600">WindowClose</animation>-->
</window>