  <disabletopbar>yes</disabletopbar>
  <controls>
    <control>
      <description>background image</description>
      <type>image</type>
      <id>1</id>
      <width>1920</width>
      <height>1080</height>
    </control>
    <control>
      <description>Header</description>
      <type>fadelabel</type>
      <id>1</id>
      <posX>100</posX>
      <posY>300</posY>
      <width>1350</width>
      <textcolor>ffffffff</textcolor>
      <shadowAngle>45</shadowAngle>
      <shadowDistance>2</shadowDistance>
      <shadowColor>ff333333</shadowColor>
      <font>font50BC</font>
      <label>5</label>
