<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<window>
	<id>614</id>
	<defaultcontrol>3</defaultcontrol>
	<allowoverlay>no</allowoverlay>
	<disabletopbar>yes</disabletopbar>
	<controls>
		<control>
			<description>background image</description>
			<type>image</type>
			<id>1</id>
			<width>1920</width>
			<height>1080</height>
		</control>

		<control>
			<description>overlay image</description>
			<type>image</type>
			<id>0</id>
			<posX>0</posX>
			<posY>0</posY>
			<width>1920</width>
			<height>1080</height>
			<texture>overlay.default.png</texture>
		</control>

		<control>
			<type>image</type>
			<id>1</id>
			<posX>159</posX>
			<posY>38</posY>
			<texture>MPLogo.png</texture>
		</control>

		<control>
			<description>Actor Name value</description>
			<type>fadelabel</type>
			<id>1</id>
			<posX>586</posX>
			<posY>188</posY>
			<width>1350</width>
			<font>font22</font>
			<textcolor>ff7FB1E5</textcolor>
			<label>#Actor.Name</label>
		</control>

		<control>
			<description>Date of Birth</description>
			<type>fadelabel</type>
			<id>1</id>
			<posX>586</posX>
			<posY>255</posY>
			<width>1350</width>
			<font>font14</font>
			<textcolor>ff909090</textcolor>
			<label>#Actor.DateOfBirth #Actor.PlaceOfBirth</label>
		</control>

		<control>
			<type>group</type>
			<description>group element</description>
			<posX>44</posX>
			<posY>102</posY>
			<width>384</width>
			<height>1080</height>
			<layout>GridLayout(6,0,0,0)</layout>
			<control>
				<description>Biography</description>
				<type>togglebutton</type>
				<id>3</id>
				<label>1011</label>
				<font>font16BC</font>
				<textureFocus>-</textureFocus>
				<textureNoFocus>-</textureNoFocus>
				<textcolor>ffffffff</textcolor>
				<colordiffuse>ffffffff</colordiffuse>
				<textcolorNoFocus>90cccccc</textcolorNoFocus>
				<textYOff>8</textYOff>
				<textureFocus>togglebutton_on.png</textureFocus>
				<textureNoFocus>togglebutton_on.png</textureNoFocus>
				<AltTextureFocus>togglebutton_off.png</AltTextureFocus>
				<AltTextureNoFocus>togglebutton_off.png</AltTextureNoFocus>
				<onleft>4</onleft>
				<onright>4</onright>
				<onup>4</onup>
				<ondown>4</ondown>
			</control>

			<control>
				<description>Movies</description>
				<type>togglebutton</type>
				<id>4</id>
				<label>342</label>
				<font>font16BC</font>
				<textureFocus>-</textureFocus>
				<textureNoFocus>-</textureNoFocus>
				<textcolor>ffffffff</textcolor>
				<colordiffuse>ffffffff</colordiffuse>
				<textcolorNoFocus>90cccccc</textcolorNoFocus>
				<textYOff>8</textYOff>
				<textureFocus>togglebutton_on.png</textureFocus>
				<textureNoFocus>togglebutton_on.png</textureNoFocus>
				<AltTextureFocus>togglebutton_off.png</AltTextureFocus>
				<AltTextureNoFocus>togglebutton_off.png</AltTextureNoFocus>
				<onleft>3</onleft>
				<onright>3</onright>
				<onup>3</onup>
				<ondown>3</ondown>
			</control>
		</control>

		<control>
			<description>Biography value</description>
			<type>textboxscrollup</type>
			<id>20</id>
			<posX>586</posX>
			<posY>300</posY>
			<width>1092</width>
			<height>480</height>
			<label>#Actor.Biography</label>
			<font>font13</font>
			<textcolor>FFFFFFFF</textcolor>
			<animation effect="zoom" end="1,1" center="550,420" time="10">WindowClose</animation>
		</control>

		<control>
			<description>textarea</description>
			<type>textbox</type>
			<id>22</id>
			<posX>586</posX>
			<posY>300</posY>
			<width>1092</width>
			<height>480</height>
			<onleft>4</onleft>
			<onright>4</onright>
			<onup>4</onup>
			<ondown>4</ondown>
			<label>#Actor.Movies</label>
		</control>

		<control>
			<description>Image logo</description>
			<type>image</type>
			<id>21</id>
			<posX>40</posX>
			<posY>184</posY>
			<width>328</width>
			<height>504</height>
			<keepaspectratio>yes</keepaspectratio>
			<texture>#thumb</texture>
			<colorkey>FFFF00FF</colorkey>
			<colordiffuse>FFFFFFFF</colordiffuse>
		</control>

		<import>common.time.xml</import>
		<import>common.overlays.xml</import>

		<control>
			<id>0</id>
			<type>image</type>
			<posX>6</posX>
			<posY>10</posY>
			<width>56</width>
			<height>42</height>
			<texture>MPLogo.png</texture>
		</control>

		<control>
			<description>Window Header shadow</description>
			<type>label</type>
			<id>0</id>
			<posX>69</posX>
			<posY>3</posY>
			<width>600</width>
			<height>75</height>
			<align>left</align>
			<font>font22</font>
			<textcolor>FF333333</textcolor>
			<label>#SkinTranslation.Translations.ArtistInfo.Label</label>
			<animation effect="fade" start="0" end="100" time="350">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="350">WindowClose</animation>
		</control>

		<control>
			<description>Window Header</description>
			<type>label</type>
			<id>0</id>
			<posX>68</posX>
			<posY>2</posY>
			<width>600</width>
			<height>75</height>
			<align>left</align>
			<font>font22</font>
			<textcolor>ffcccccc</textcolor>
			<label>#SkinTranslation.Translations.ArtistInfo.Label</label>
			<animation effect="fade" start="0" end="100" time="350">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="350">WindowClose</animation>
		</control>

	</controls>

</window>
