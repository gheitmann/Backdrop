<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<window>
  <id>101</id>
  <defaultcontrol>10</defaultcontrol>
  <allowoverlay>no</allowoverlay>
  <disabletopbar>yes</disabletopbar>
  <controls>
    <import>common.dialog.xml</import>
    <control>
      <type>image</type>
      <id>100</id>
      <posX>608</posX>
      <posY>540</posY>
      <width>708</width>
      <height>21</height>
      <texture>osdprogressback.png</texture>
    </control>
    <control>
      <description>progress control</description>
      <type>progress</type>
      <id>20</id>
      <posX>585</posX>
      <posY>540</posY>
      <width>735</width>
      <height>21</height>
      <texturebg>-</texturebg>
      <lefttexture>osdprogressleft.png</lefttexture>
      <midtexture>osdprogressmid.png</midtexture>
      <righttexture>osdprogressright.png</righttexture>
    </control>
    <control>
      <description>OK button</description>
      <type>button</type>
      <id>10</id>
      <font>font14BC</font>
      <textureFocus>button.focus.png</textureFocus>
      <textureNoFocus>button.focus.png</textureNoFocus>
      <width>150</width>
      <height>52</height>
      <posX>861</posX>
      <posY>615</posY>
      <textcolor>ffffffff</textcolor>
      <colordiffuse>ffffffff</colordiffuse>
      <disabledcolor>80ffffff</disabledcolor>
      <textcolorNoFocus>80ffffff</textcolorNoFocus>
      <textXOff>2</textXOff>
      <textYOff>2</textYOff>
      <textalign>center</textalign>
      <label>510</label>
      <onleft>10</onleft>
      <onright>10</onright>
      <onup>10</onup>
      <ondown>10</ondown>
    </control>
  </controls>
  <animation effect="zoom" delay="20" tween="back" easing="out" start="55,55" end="100,100" center="960,600" time="550">WindowOpen</animation>
  <animation effect="zoom" start="100,100" end="1,1" center="960,600" time="350">WindowClose</animation>
</window>