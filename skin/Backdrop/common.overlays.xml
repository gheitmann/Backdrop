<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
Contains Music and Video Overlay
same location everywhere
-->
<window>
  <controls>
    <!--                                    :: DUMMY / BACKGROUND ::                                    -->
    <control>
      <description>dummy (visible when music is playing)</description>
      <type>label</type>
      <id>3337</id>
      <posX>3000</posX>
      <label>#Play.Current.Artist</label>
      <visible>Player.HasAudio+player.hasaudio</visible>
    </control>
    <control>
      <description>dummy (visible when there is a next track)</description>
      <type>label</type>
      <id>3338</id>
      <posX>3000</posX>
      <label>#Play.Next.Title</label>
      <visible>Player.HasAudio+control.hastext(3338)</visible>
    </control>
    <control>
      <description>dummy (visible when tv is running)</description>
      <type>label</type>
      <id>3339</id>
      <posX>3000</posX>
      <label>#TV.View.channel</label>
      <visible>Player.HasVideo+!control.hastext(3337)</visible>
    </control>
    <control>
      <description>Header Background</description>
      <type>image</type>
      <id>0</id>
      <posX>0</posX>
      <posY>0</posY>
      <width>1920</width>
      <height>1080</height>
      <texture>playing.overlay.png</texture>
      <visible>Player.HasVideo|Player.HasAudio</visible>
    </control>
    <!-- MUSIC******************************************************************************************-->
    <control>
      <description>Line separator</description>
      <type>image</type>
      <id>0</id>
      <posX>1365</posX>
      <posY>189</posY>
      <width>360</width>
      <height>9</height>
      <shouldCache>true</shouldCache>
      <texture>line.separator.png</texture>
      <visible>[[control.isvisible(3337)+Player.HasAudio]|[Player.HasAudio+!control.isvisible(3337)+!control.isvisible(3339)]]+![facadeview.smallicons|facadeview.largeicons]+!control.isvisible(51)</visible>
    </control>
    <control>
      <description>Music Thumb Default</description>
      <id>0</id>
      <type>image</type>
      <posX>1678</posX>
      <posY>142</posY>
      <width>238</width>
      <height>238</height>
      <keepaspectratio>no</keepaspectratio>
      <centered>yes</centered>
      <zoom>yes</zoom>
      <shouldCache>true</shouldCache>
      <texture mask="music_frame_rounder_corners_background1.png">nothumb.png</texture>
      <visible>[[control.isvisible(3337)+Player.HasAudio+![Control.hasthumb(987896)|Control.hasthumb(987897)]]|[[Player.HasAudio+!control.isvisible(3337)+!control.isvisible(3339)]]+![Control.hasthumb(987896)|Control.hasthumb(987897)]]+![facadeview.smallicons|facadeview.largeicons]+!control.isvisible(51)</visible>
    </control>
    <control>
      <description>Music Thumb</description>
      <id>987896</id>
      <type>image</type>
      <posX>1678</posX>
      <posY>142</posY>
      <width>238</width>
      <height>238</height>
      <keepaspectratio>no</keepaspectratio>
      <centered>yes</centered>
      <zoom>yes</zoom>
      <texture mask="music_frame_rounder_corners_background1.png">#Play.Current.Thumb</texture>
      <visible>[[control.isvisible(3337)+Player.HasAudio]|[Player.HasAudio+!control.isvisible(3337)+!control.isvisible(3339)]]+![facadeview.smallicons|facadeview.largeicons]+!control.isvisible(51)</visible>
    </control>
    <control>
      <description>Music Thumb</description>
      <id>987897</id>
      <type>image</type>
      <posX>1678</posX>
      <posY>142</posY>
      <width>238</width>
      <height>238</height>
      <keepaspectratio>no</keepaspectratio>
      <centered>yes</centered>
      <zoom>yes</zoom>
      <!--<texture mask="music_frame_rounder_corners_background1.png">#Play.Current.ArtistThumb</texture>  -->
      <texture mask="music_frame_rounder_corners_background1.png">#fanarthandler.music.artisthumb.play</texture>
      <visible>[[control.isvisible(3337)+Player.HasAudio]|[Player.HasAudio+!control.isvisible(3337)+!control.isvisible(3339)]]+![facadeview.smallicons|facadeview.largeicons]+!control.isvisible(51)</visible>
    </control>
    <control>
      <description>Frame Music</description>
      <type>image</type>
      <id>0</id>
      <posX>1678</posX>
      <posY>142</posY>
      <width>238</width>
      <height>238</height>
      <texture>music_frame_rounder_corners.png</texture>
      <visible>[[control.isvisible(3337)+Player.HasAudio]|[Player.HasAudio+!control.isvisible(3337)+!control.isvisible(3339)]]+![facadeview.smallicons|facadeview.largeicons]+!control.isvisible(51)</visible>
