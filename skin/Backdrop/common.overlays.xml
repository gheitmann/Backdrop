    <control>
      <description>progress bar</description>
      <type>progress</type>
      <id>0</id>
      <label>#percentage</label>
      <lefttexture>-</lefttexture>
      <midtexture>progressbar_mid.png</midtexture>
      <righttexture>-</righttexture>
      <visible>control.isvisible(3337)+Player.HasAudio+![facadeview.smallicons|facadeview.largeicons]+!control.isvisible(51)</visible>
      <posX>1449</posX>
      <posY>328</posY>
      <width>231</width>
      <height>15</height>
      <texturebg>progressback.png</texturebg>
      <onlymidtexture>yes</onlymidtexture>
      <midwidth>231</midwidth>
      <midheight>15</midheight>
      <midoffsetX>0</midoffsetX>
      <midoffsetY>0</midoffsetY>
    </control>
    <control>
      <description>play time / duration label</description>
