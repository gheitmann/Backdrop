    <control>
      <description>Artist label</description>
      <type>fadelabel</type>
      <id>0</id>
      <width>600</width>
      <height>60</height>
      <posX>1680</posX>
      <posY>154</posY>
      <label>#Play.Current.Artist</label>
      <align>right</align>
      <textcolor>ffffffff</textcolor>
      <shadowAngle>45</shadowAngle>
      <shadowDistance>2</shadowDistance>
      <shadowColor>ff191919</shadowColor>
      <font>font13BCB</font>
      <visible>control.isvisible(3337)+Player.HasAudio+![facadeview.smallicons|facadeview.largeicons]+!control.isvisible(51)</visible>
    </control>
    <control>
